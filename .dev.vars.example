# Local development secrets for `wrangler dev`. Never commit real values.
# OIDC_SIGNING_PRIVATE_KEY must be an RSA >=2048 key in PKCS#8 form
# ("-----BEGIN PRIVATE KEY-----", e.g. `openssl genpkey -algorithm RSA
# -pkeyopt rsa_keygen_bits:2048`) or base64 PKCS#8 DER; PKCS#1
# ("-----BEGIN RSA PRIVATE KEY-----") is not accepted. Newlines may be
# escaped as \n when setting the value.

DISCORD_CLIENT_SECRET=replace-me
OIDC_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Only needed when OIDC_CLIENTS_JSON registers confidential clients:
# OIDC_CLIENT_SECRETS_JSON={"rp-b-client-id":"at-least-16-chars"}
# Bearer token for the /admin/clients API (dynamic RP registry). Generate a
# high-entropy value (e.g. `openssl rand 32 | base64 | tr '+/' '-_' | tr -d '=\n'`).
# If unset the admin API fails closed: every request is 401.
# OIDC_ADMIN_API_TOKEN=replace-me
